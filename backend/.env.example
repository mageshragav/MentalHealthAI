# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
COLLECTION_NAME=dsm5_collection

# Chunking Configuration - Metadata Stage
METADATA_EXTRACTION_ENABLED=true
PRESERVE_DIAGNOSTIC_CRITERIA=true
EXTRACT_ICD_CODES=true
CAPTURE_SPECIFIERS=true
HIERARCHY_DEPTH=3

# Chunking Configuration - Semantic Stage
SEMANTIC_BREAKPOINT_THRESHOLD=0.75
MIN_CHUNK_SIZE=500
MAX_CHUNK_SIZE=2000
CHUNK_OVERLAP=100
BUFFER_SIZE=1

# RAG Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
RERANK_ENABLED=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend Configuration
STREAMLIT_PORT=8501
BACKEND_URL=http://localhost:8000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Safety Configuration
ENABLE_DISCLAIMER=true
REQUIRE_DISCLAIMER_ACCEPTANCE=true
LOG_USER_QUERIES=false